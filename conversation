"""
Address generation system for MyDesk.
Generates unique 12-character addresses based on machine fingerprint.
Format: XXXXX-XXX-XXXX (5 chars machine hash + 3 chars date + 4 chars random)
"""
import hashlib
import uuid
import platform
import random
import string
from datetime import datetime


def get_machine_fingerprint():
    """
    Generate a machine fingerprint based on MAC, hostname, and OS.
    
    Returns:
        str: Machine fingerprint string
    """
    # Get MAC address
    mac = uuid.getnode()
    mac_str = ':'.join(('%012X' % mac)[i:i+2] for i in range(0, 12, 2))
    
    # Get hostname
    hostname = platform.node()
    
    # Get OS info
    os_info = platform.system() + platform.release()
    
    # Combine all
    fingerprint = f"{mac_str}_{hostname}_{os_info}"
    
    return fingerprint


def generate_machine_hash():
    """
    Generate 5-character Base36 hash from machine fingerprint.
    
    Returns:
        str: 5-character machine hash (uppercase)
    """
    fingerprint = get_machine_fingerprint()
    
    # Create SHA256 hash
    hash_obj = hashlib.sha256(fingerprint.encode())
    hash_int = int(hash_obj.hexdigest(), 16)
    
    # Convert to Base36 (0-9, A-Z)
    base36_chars = string.digits + string.ascii_uppercase
    result = []
    
    for _ in range(5):
        result.append(base36_chars[hash_int % 36])
        hash_int //= 36
    
    return ''.join(result)


def generate_date_code():
    """
    Generate 3-character date code from day of year and year.
    Format: (DayOfYear + YearMod10) encoded in Base36
    
    Returns:
        str: 3-character date code
    """
    now = datetime.now()
    day_of_year = now.timetuple().tm_yday  # 1-366
    year_last_digit = now.year % 10  # 0-9
    
    # Combine: multiply year digit by 366 and add day
    combined = (year_last_digit * 366) + day_of_year
    
    # Convert to Base36 (3 characters)
    base36_chars = string.digits + string.ascii_uppercase
    result = []
    
    for _ in range(3):
        result.append(base36_chars[combined % 36])
        combined //= 36
    
    return ''.join(result)


def generate_random_code():
    """
    Generate 4-character random code in Base36.
    
    Returns:
        str: 4-character random code
    """
    base36_chars = string.digits + string.ascii_uppercase
    return ''.join(random.choice(base36_chars) for _ in range(4))


def generate_address():
    """
    Generate a complete 12-character MyDesk address.
    Format: XXXXX-XXX-XXXX
    
    Returns:
        str: Formatted 12-character address with dashes
    """
    machine_hash = generate_machine_hash()  # 5 chars
    date_code = generate_date_code()        # 3 chars
    random_code = generate_random_code()    # 4 chars
    
    # Combine with dashes
    address = f"{machine_hash}-{date_code}-{random_code}"
    
    return address


def validate_address_format(address):
    """
    Validate address format (XXXXX-XXX-XXXX).
    
    Args:
        address: Address string to validate
        
    Returns:
        bool: True if format is valid
    """
    if not address or len(address) != 14:  # 12 chars + 2 dashes
        return False
    
    parts = address.split('-')
    if len(parts) != 3:
        return False
    
    if len(parts[0]) != 5 or len(parts[1]) != 3 or len(parts[2]) != 4:
        return False
    
    # Check if all characters are valid Base36
    base36_chars = set(string.digits + string.ascii_uppercase)
    for part in parts:
        if not all(c in base36_chars for c in part.upper()):
            return False
    
    return True


